<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WiiiiGotThis.Presentation"
             xmlns:p="using:WiiiiGotThis.Presentation"
             x:Class="WiiiiGotThis.Presentation.DesktopShellView"
             x:DataType="vm:ShellViewModel">
  <Grid>
    <p:DesktopAtlasView x:Name="AtlasWorkspace"
                        IsVisible="{Binding IsAtlasVisible}" />

    <Grid IsVisible="{Binding IsJobsVisible}" Margin="24" RowDefinitions="Auto,*" RowSpacing="14">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <Button Width="42"
                Height="42"
                CornerRadius="21"
                Padding="0"
                Content="◎"
                Command="{Binding ReturnToAtlasCommand}"
                AutomationProperties.Name="Return to WGT Atlas"
                AutomationProperties.AutomationId="ReturnToAtlasFromJobs" />
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <TextBlock Classes="wgt-caption" Text="VOCATION · TRANSITIONAL CAPABILITY SURFACE" />
          <TextBlock Classes="wgt-section-title" Text="Opportunity Overview" />
        </StackPanel>
      </Grid>
      <Border Grid.Row="1" Classes="wgt-surface">
        <p:VocationOpportunityOverviewView x:Name="JobsWorkspace"
                                           DataContext="{Binding OpenedVocationOpportunityOverview}" />
      </Border>
    </Grid>

    <Grid IsVisible="{Binding IsMapVisible}" Margin="24" RowDefinitions="Auto,*" RowSpacing="14">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <Button Width="42"
                Height="42"
                CornerRadius="21"
                Padding="0"
                Content="◎"
                Command="{Binding ReturnToAtlasCommand}"
                AutomationProperties.Name="Return to WGT Atlas"
                AutomationProperties.AutomationId="ReturnToAtlasFromMap" />
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <TextBlock Classes="wgt-caption" Text="VOCATION · ORIENTATION · TRANSITIONAL CAPABILITY SURFACE" />
          <TextBlock Classes="wgt-section-title" Text="Opportunity Map" />
        </StackPanel>
      </Grid>
      <Border Grid.Row="1" Classes="wgt-surface">
        <p:VocationMapProjectionView x:Name="MapWorkspace"
                                     DataContext="{Binding OpenedVocationMapProjection}" />
      </Border>
    </Grid>

    <Grid IsVisible="{Binding IsSettingsVisible}">
      <p:DesktopAtlasView />
      <Border HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Margin="24,78,24,0"
              Classes="wgt-atlas-popover"
              Padding="12">
        <StackPanel Spacing="4">
          <TextBlock FontWeight="SemiBold" Text="WGT settings moved into the Atlas" />
          <TextBlock Classes="wgt-secondary"
                     MaxWidth="260"
                     Text="Use the small settings control in the Atlas. Service configuration belongs to the relevant service node."
                     TextWrapping="Wrap" />
          <Button Command="{Binding ReturnToAtlasCommand}" Content="Open Atlas" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
