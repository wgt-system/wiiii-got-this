<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:WiiiiGotThis.Presentation" xmlns:p="using:WiiiiGotThis.Presentation" x:Class="WiiiiGotThis.Presentation.DesktopShellView" x:DataType="vm:ShellViewModel">
  <Grid ColumnDefinitions="224,*">
    <Border Classes="wgt-shell-sidebar" Grid.Column="0" CornerRadius="0" BorderThickness="0,0,1,0" Padding="20">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="3">
          <TextBlock Classes="wgt-page-title" FontSize="22">Wiiii Got This</TextBlock>
          <TextBlock Classes="wgt-secondary" Text="Workspace" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,28,0,0" Spacing="2">
          <RadioButton Classes="wgt-shell-nav" GroupName="ShellNavigation" Content="Home" Command="{Binding ShowHomeCommand}" IsChecked="{Binding IsHomeActive, Mode=OneWay}" />
          <RadioButton Classes="wgt-shell-nav" GroupName="ShellNavigation" Content="Jobs" Command="{Binding ShowJobsCommand}" IsChecked="{Binding IsJobsActive, Mode=OneWay}" />
          <RadioButton Classes="wgt-shell-nav" GroupName="ShellNavigation" Content="Map" IsVisible="{Binding IsMapAvailable}" Command="{Binding ShowMapCommand}" IsChecked="{Binding IsMapActive, Mode=OneWay}" />
          <Separator Margin="0,14" />
          <RadioButton Classes="wgt-shell-nav" GroupName="ShellNavigation" Content="Settings" Command="{Binding ShowSettingsCommand}" IsChecked="{Binding IsSettingsActive, Mode=OneWay}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="3">
          <TextBlock Classes="wgt-caption" Text="THIS DEVICE" />
          <TextBlock Classes="wgt-body" Text="{Binding CurrentDeviceName}" TextWrapping="Wrap" />
          <TextBlock Classes="wgt-caption" Text="{Binding StatusText}" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" Margin="32,28">
      <Grid IsVisible="{Binding IsHomeVisible}" RowDefinitions="Auto,*">
        <StackPanel Spacing="4" Margin="0,0,0,22">
          <TextBlock Classes="wgt-page-title">Home</TextBlock>
          <TextBlock Classes="wgt-secondary" Text="Your current WGT product areas." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="20">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
              <Border Classes="wgt-product-card" IsVisible="{Binding IsJobsAvailable}">
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
                  <TextBlock Classes="wgt-caption" Text="VOCATION" />
                  <TextBlock Grid.Row="1" Classes="wgt-section-title">Jobs</TextBlock>
                  <TextBlock Grid.Row="2" Classes="wgt-secondary" Text="Browse the opportunities currently published by Vocation." TextWrapping="Wrap" />
                  <Button Grid.Row="3" Classes="wgt-action-button" Command="{Binding ShowJobsCommand}" Content="Open Jobs" HorizontalAlignment="Left" Margin="0,8,0,0" />
                </Grid>
              </Border>

              <Border Grid.Column="1" Classes="wgt-product-card" IsVisible="{Binding IsMapAvailable}">
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
                  <TextBlock Classes="wgt-caption" Text="VOCATION · ORIENTATION" />
                  <TextBlock Grid.Row="1" Classes="wgt-section-title">Map</TextBlock>
                  <TextBlock Grid.Row="2" Classes="wgt-secondary" Text="Explore published opportunity locations on the shared Orientation map." TextWrapping="Wrap" />
                  <Button Grid.Row="3" Classes="wgt-action-button" Command="{Binding ShowMapCommand}" Content="Open Map" HorizontalAlignment="Left" Margin="0,8,0,0" />
                </Grid>
              </Border>
            </Grid>

            <Border Classes="wgt-product-card">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                <StackPanel Spacing="6">
                  <TextBlock Classes="wgt-caption" Text="WGT" />
                  <TextBlock Classes="wgt-section-title">Connections</TextBlock>
                  <TextBlock Classes="wgt-secondary" Text="Choose which integrations are active on this device and inspect connection health when needed." TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Classes="wgt-action-button" Command="{Binding ShowSettingsCommand}" Content="Open Settings" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Grid IsVisible="{Binding IsJobsVisible}" RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,18">
          <StackPanel Spacing="4">
            <TextBlock Classes="wgt-page-title">Jobs</TextBlock>
            <TextBlock Classes="wgt-secondary" Text="Published opportunities from Vocation." />
          </StackPanel>
        </Grid>
        <Border Classes="wgt-surface" Grid.Row="1">
          <p:VocationOpportunityOverviewView DataContext="{Binding OpenedVocationOpportunityOverview}" />
        </Border>
      </Grid>

      <Grid IsVisible="{Binding IsMapVisible}" RowDefinitions="Auto,*">
        <StackPanel Spacing="4" Margin="0,0,0,18">
          <TextBlock Classes="wgt-page-title">Map</TextBlock>
          <TextBlock Classes="wgt-secondary" Text="Opportunity locations from Vocation, rendered by Orientation." />
        </StackPanel>
        <Border Classes="wgt-surface" Grid.Row="1">
          <p:VocationMapProjectionView DataContext="{Binding OpenedVocationMapProjection}" />
        </Border>
      </Grid>

      <Grid IsVisible="{Binding IsSettingsVisible}" RowDefinitions="Auto,*">
        <StackPanel Spacing="4" Margin="0,0,0,18">
          <TextBlock Classes="wgt-page-title">Settings</TextBlock>
          <TextBlock Classes="wgt-secondary" Text="Manage connections and device behavior." />
        </StackPanel>

        <Grid Grid.Row="1" MinWidth="760" ColumnDefinitions="260,*" ColumnSpacing="16">
          <Border Classes="wgt-surface">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
                <TextBlock Classes="wgt-section-title" FontSize="18">Connections</TextBlock>
                <TextBlock Classes="wgt-caption" Text="Choose a connection to manage." TextWrapping="Wrap" />
              </StackPanel>
              <ListBox ItemsSource="{Binding Integrations}" SelectedItem="{Binding SelectedIntegration, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="p:ServiceIntegrationPresentationViewModel">
                    <Border Classes="wgt-list-divider" Padding="4,9,4,11">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Classes="wgt-caption" IsVisible="{Binding IsReferenceIntegration}" Text="DEVELOPER REFERENCE" />
                        <TextBlock Classes="wgt-secondary" Text="{Binding EffectiveEnablementText}" />
                        <TextBlock Classes="wgt-caption" Text="{Binding ConnectionHealthTitle}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>

          <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
              <Border Classes="wgt-surface">
                <StackPanel Spacing="14">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="3">
                      <TextBlock Classes="wgt-caption" Text="SELECTED CONNECTION" />
                      <TextBlock Classes="wgt-section-title" Text="{Binding SelectedIntegration.DisplayName}" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Classes="wgt-body" FontWeight="SemiBold" Text="{Binding SelectedIntegration.EffectiveEnablementText}" VerticalAlignment="Center" />
                  </Grid>

                  <Separator />

                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="4">
                      <TextBlock FontWeight="SemiBold">Global availability</TextBlock>
                      <TextBlock Classes="wgt-secondary" Text="{Binding SelectedIntegration.GlobalEnablementText}" />
                      <TextBlock Classes="wgt-caption" Text="Sets the default for devices unless they have an explicit override." TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <Button Classes="wgt-action-button" IsVisible="{Binding SelectedIntegration.ShowEnableGloballyAction}" Command="{Binding EnableGloballyCommand}" Content="Enable globally" />
                      <Button Classes="wgt-action-button" IsVisible="{Binding SelectedIntegration.ShowDisableGloballyAction}" Command="{Binding DisableGloballyCommand}" Content="Disable globally" />
                    </StackPanel>
                  </Grid>

                  <Separator />

                  <StackPanel Spacing="8">
                    <StackPanel Spacing="4">
                      <TextBlock FontWeight="SemiBold">This device</TextBlock>
                      <TextBlock Classes="wgt-secondary" Text="{Binding SelectedIntegration.DeviceOverrideText}" />
                      <TextBlock Classes="wgt-caption" Text="{Binding SelectedIntegration.DeviceBehaviorText}" TextWrapping="Wrap" />
                    </StackPanel>
                    <WrapPanel>
                      <Button IsVisible="{Binding SelectedIntegration.ShowEnableOnDeviceAction}" Command="{Binding EnableOnThisDeviceCommand}" Content="Enable on this device" Margin="0,0,8,6" />
                      <Button IsVisible="{Binding SelectedIntegration.ShowDisableOnDeviceAction}" Command="{Binding DisableOnThisDeviceCommand}" Content="Disable on this device" Margin="0,0,8,6" />
                      <Button IsVisible="{Binding SelectedIntegration.HasDeviceOverride}" Command="{Binding InheritGlobalSettingCommand}" Content="Use global setting" Margin="0,0,8,6" />
                    </WrapPanel>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Classes="wgt-surface">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="4">
                      <TextBlock FontWeight="SemiBold">Connection health</TextBlock>
                      <TextBlock Classes="wgt-section-title" FontSize="17" Text="{Binding SelectedIntegration.ConnectionHealthTitle}" />
                      <TextBlock Classes="wgt-secondary" Text="{Binding SelectedIntegration.ConnectionHealthDescription}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="wgt-action-button" Command="{Binding RefreshCommand}" Content="Refresh" VerticalAlignment="Top" />
                  </Grid>

                  <Expander Header="Diagnostics">
                    <StackPanel Spacing="5" Margin="0,8,0,0">
                      <TextBlock Classes="wgt-caption" Text="{Binding SelectedIntegration.PublicationRefreshStatusText}" TextWrapping="Wrap" />
                      <TextBlock Classes="wgt-caption" Text="{Binding SelectedIntegration.LastRefreshAttemptText}" TextWrapping="Wrap" />
                      <TextBlock Classes="wgt-caption" Text="{Binding SelectedIntegration.LastSuccessfulRefreshText}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Expander>
                </StackPanel>
              </Border>

              <Border Classes="wgt-surface">
                <Grid RowDefinitions="Auto,*">
                  <StackPanel Spacing="3" Margin="0,0,0,10">
                    <TextBlock FontWeight="SemiBold">Capabilities</TextBlock>
                    <TextBlock Classes="wgt-caption" Text="What this connection can currently provide to WGT." />
                  </StackPanel>

                  <Grid Grid.Row="1" ColumnDefinitions="1.05*,1.35*" ColumnSpacing="16" MinHeight="220">
                    <ListBox ItemsSource="{Binding SelectedIntegrationCapabilities}" SelectedItem="{Binding SelectedCapability, Mode=TwoWay}">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:CapabilityPresentationViewModel">
                          <Border Classes="wgt-list-divider" Padding="4,7,4,9">
                            <StackPanel Spacing="3">
                              <TextBlock Text="{Binding CapabilityTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                              <TextBlock Classes="wgt-caption" Text="{Binding StatusText}" TextWrapping="Wrap" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Column="1" IsVisible="{Binding IsCapabilityDetailsVisible}" Spacing="8">
                      <TextBlock Classes="wgt-caption" Text="SELECTED CAPABILITY" />
                      <TextBlock Classes="wgt-section-title" FontSize="18" Text="{Binding SelectedCapability.CapabilityTitle}" TextWrapping="Wrap" />
                      <TextBlock Classes="wgt-secondary" Text="{Binding SelectedCapability.StatusText}" TextWrapping="Wrap" />
                      <Button Command="{Binding OpenCapabilityCommand}" Content="Open" HorizontalAlignment="Left" />
                      <Expander Header="Technical details">
                        <StackPanel Spacing="4" Margin="0,8,0,0">
                          <TextBlock Classes="wgt-caption" Text="{Binding SelectedCapability.ServiceDisplayName}" TextWrapping="Wrap" />
                          <TextBlock Classes="wgt-caption" Text="{Binding SelectedCapability.CapabilityIdentity.Value}" TextWrapping="Wrap" />
                          <TextBlock Classes="wgt-caption" Text="Contract {Binding SelectedCapability.ContractVersion}" />
                        </StackPanel>
                      </Expander>
                    </StackPanel>

                    <StackPanel Grid.Column="1" IsVisible="{Binding IsReferenceCapabilityOpen}" Spacing="8">
                      <TextBlock Classes="wgt-caption" Text="DEVELOPER REFERENCE" />
                      <TextBlock Classes="wgt-section-title" FontSize="18" Text="{Binding OpenedReferenceCapability.CapabilityTitle}" />
                      <TextBlock Text="Available" FontWeight="SemiBold" />
                      <TextBlock Classes="wgt-secondary" Text="This reference capability is available through Wiiii Got This." TextWrapping="Wrap" />
                      <Expander Header="Technical details">
                        <StackPanel Spacing="4" Margin="0,8,0,0">
                          <TextBlock Classes="wgt-caption" Text="{Binding OpenedReferenceCapability.CapabilityIdentity.Value}" />
                          <TextBlock Classes="wgt-caption" Text="Contract {Binding OpenedReferenceCapability.ContractVersion}" />
                        </StackPanel>
                      </Expander>
                      <Button Command="{Binding BackToCatalogCommand}" Content="Back" HorizontalAlignment="Left" />
                    </StackPanel>
                  </Grid>
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
