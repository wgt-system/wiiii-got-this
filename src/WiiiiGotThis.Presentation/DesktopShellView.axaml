<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:WiiiiGotThis.Presentation" xmlns:app="using:WiiiiGotThis.Application" xmlns:p="using:WiiiiGotThis.Presentation" x:Class="WiiiiGotThis.Presentation.DesktopShellView" x:DataType="vm:ShellViewModel">
  <Grid RowDefinitions="Auto,Auto,*" Margin="20">
    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
      <StackPanel><TextBlock FontSize="28" FontWeight="Bold">Wiiii Got This</TextBlock><TextBlock Text="{Binding CurrentDeviceName}" Opacity="0.7" /></StackPanel>
      <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="12,0" Text="{Binding StatusText}" />
      <Button Grid.Column="2" Command="{Binding RefreshCommand}" Content="Refresh" MinWidth="90" />
    </Grid>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
      <Button Command="{Binding ShowHomeCommand}" Content="Home" MinWidth="100" />
      <Button Command="{Binding ShowSettingsCommand}" Content="Settings" MinWidth="100" />
    </StackPanel>
    <Grid Grid.Row="2" IsVisible="{Binding IsHomeVisible}">
      <StackPanel MaxWidth="720" Spacing="12" HorizontalAlignment="Left" VerticalAlignment="Top">
        <TextBlock FontSize="24" FontWeight="SemiBold">Welcome to Wiiii Got This</TextBlock>
        <TextBlock Text="Your connected WGT product areas will appear here." FontSize="16" />
        <TextBlock Text="Use Settings to manage integrations and open their published capabilities." Opacity="0.75" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
    <Grid Grid.Row="2" IsVisible="{Binding IsSettingsVisible}" RowDefinitions="Auto,*" ColumnDefinitions="240,300,*">
      <TextBlock Grid.Row="0" Grid.ColumnSpan="3" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12">Integration settings</TextBlock>
      <Border Grid.Row="1" Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,12,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,8">Integrations</TextBlock>
          <ListBox ItemsSource="{Binding Integrations}" SelectedItem="{Binding SelectedIntegration, Mode=TwoWay}">
            <ListBox.ItemTemplate><DataTemplate x:DataType="p:ServiceIntegrationPresentationViewModel"><StackPanel Margin="0,4"><TextBlock Text="{Binding DisplayName}" /><TextBlock FontSize="11" Text="{Binding EnablementStatusText}" /><TextBlock FontSize="11" Text="{Binding PublicationRefreshStatusText}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <Border Grid.Row="1" Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,12,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,8">Published capabilities</TextBlock>
          <ListBox ItemsSource="{Binding Capabilities}" SelectedItem="{Binding SelectedCapability, Mode=TwoWay}">
            <ListBox.ItemTemplate><DataTemplate x:DataType="vm:CapabilityPresentationViewModel"><StackPanel Margin="0,4"><TextBlock Text="{Binding CapabilityTitle}" /><TextBlock FontSize="11" Text="{Binding StatusText}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <Border Grid.Row="1" Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Padding="14">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="8">
            <TextBlock FontWeight="Bold">Integration management</TextBlock>
            <WrapPanel><Button Command="{Binding EnableGloballyCommand}" Content="Enable globally" Margin="0,0,6,6" /><Button Command="{Binding DisableGloballyCommand}" Content="Disable globally" Margin="0,0,6,6" /></WrapPanel>
            <WrapPanel><Button Command="{Binding EnableOnThisDeviceCommand}" Content="Enable on this device" Margin="0,0,6,6" /><Button Command="{Binding DisableOnThisDeviceCommand}" Content="Disable on this device" Margin="0,0,6,6" /></WrapPanel>
            <Button Command="{Binding InheritGlobalSettingCommand}" Content="Inherit global setting" HorizontalAlignment="Left" />
            <Separator Margin="0,8" />
            <TextBlock FontWeight="Bold">Selected integration</TextBlock>
            <TextBlock Text="{Binding SelectedIntegration.DisplayName}" FontSize="18" />
            <TextBlock Text="{Binding SelectedIntegration.EnablementStatusText}" />
            <TextBlock Text="{Binding SelectedIntegration.PublicationRefreshStatusText}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SelectedIntegration.LastRefreshAttemptText}" FontSize="11" />
            <TextBlock Text="{Binding SelectedIntegration.LastSuccessfulRefreshText}" FontSize="11" />
            <Separator Margin="0,8" />
            <StackPanel IsVisible="{Binding IsCapabilityDetailsVisible}" Spacing="8">
              <TextBlock FontWeight="Bold">Selected capability</TextBlock>
              <TextBlock Text="{Binding SelectedCapability.CapabilityTitle}" FontSize="20" />
              <TextBlock Text="{Binding SelectedCapability.ServiceDisplayName}" />
              <TextBlock Text="{Binding SelectedCapability.CapabilityIdentity.Value}" />
              <TextBlock Text="{Binding SelectedCapability.ContractVersion}" />
              <TextBlock Text="{Binding SelectedCapability.StatusText}" TextWrapping="Wrap" />
              <Button Command="{Binding OpenCapabilityCommand}" Content="Open" HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel IsVisible="{Binding IsReferenceCapabilityOpen}" Spacing="8">
              <TextBlock FontWeight="Bold">Reference Capability</TextBlock><TextBlock Text="{Binding OpenedReferenceCapability.CapabilityTitle}" FontSize="20" /><TextBlock Text="{Binding OpenedReferenceCapability.ServiceDisplayName}" /><TextBlock Text="{Binding OpenedReferenceCapability.CapabilityIdentity.Value}" /><TextBlock Text="{Binding OpenedReferenceCapability.ContractVersion}" /><TextBlock Text="Available" /><TextBlock Text="This reference capability is available through Wiiii Got This." TextWrapping="Wrap" /><Button Command="{Binding BackToCatalogCommand}" Content="Back to catalog" HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel IsVisible="{Binding IsVocationOpportunityOverviewOpen}" Spacing="8">
              <p:VocationOpportunityOverviewView DataContext="{Binding OpenedVocationOpportunityOverview}" /><Button Command="{Binding BackToCatalogCommand}" Content="Back to catalog" HorizontalAlignment="Left" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
