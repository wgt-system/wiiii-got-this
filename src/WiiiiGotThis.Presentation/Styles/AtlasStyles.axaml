<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <SolidColorBrush x:Key="WgtAtlasBackgroundBrush" Color="{DynamicResource SystemAltHighColor}" Opacity="0.99" />
    <SolidColorBrush x:Key="WgtAtlasNodeBrush" Color="{DynamicResource SystemRegionColor}" />
    <SolidColorBrush x:Key="WgtAtlasNodeBorderBrush" Color="{DynamicResource SystemBaseLowColor}" />
    <SolidColorBrush x:Key="WgtAtlasConnectionBrush" Color="{DynamicResource SystemBaseMediumColor}" Opacity="0.42" />
    <SolidColorBrush x:Key="WgtAtlasCapabilityConnectionBrush" Color="{DynamicResource SystemAccentColor}" Opacity="0.36" />
    <SolidColorBrush x:Key="WgtAtlasDependencyConnectionBrush" Color="{DynamicResource SystemAccentColor}" Opacity="0.76" />
    <SolidColorBrush x:Key="WgtAtlasGridBrush" Color="{DynamicResource SystemBaseLowColor}" Opacity="0.18" />
    <SolidColorBrush x:Key="WgtAtlasSelectedBrush" Color="{DynamicResource SystemAccentColor}" Opacity="0.13" />
    <SolidColorBrush x:Key="WgtAtlasChromeBrush" Color="{DynamicResource SystemRegionColor}" />
  </Styles.Resources>

  <Style Selector="Grid.wgt-atlas-root">
    <Setter Property="Background" Value="{DynamicResource WgtAtlasBackgroundBrush}" />
  </Style>
  <Style Selector="Grid.wgt-atlas-root.theme-elegant">
    <Setter Property="Background" Value="{DynamicResource WgtSurfaceBrush}" />
  </Style>
  <Style Selector="Grid.wgt-atlas-root.theme-machine">
    <Setter Property="Background" Value="{DynamicResource WgtAtlasBackgroundBrush}" />
  </Style>
  <Style Selector="Grid.wgt-atlas-root.theme-world">
    <Setter Property="Background" Value="{DynamicResource WgtAccentLowBrush}" />
  </Style>

  <Style Selector="Line.wgt-atlas-gridline">
    <Setter Property="Stroke" Value="{DynamicResource WgtAtlasGridBrush}" />
    <Setter Property="StrokeThickness" Value="1" />
  </Style>
  <Style Selector="Line.wgt-atlas-gridline.theme-elegant">
    <Setter Property="Opacity" Value="0.35" />
  </Style>
  <Style Selector="Line.wgt-atlas-gridline.theme-machine">
    <Setter Property="Opacity" Value="0.7" />
  </Style>
  <Style Selector="Line.wgt-atlas-gridline.theme-world">
    <Setter Property="Opacity" Value="0.16" />
  </Style>

  <Style Selector="Button.wgt-atlas-node">
    <Setter Property="Background" Value="{DynamicResource WgtAtlasNodeBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WgtAtlasNodeBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
  </Style>
  <Style Selector="Button.wgt-atlas-node:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource WgtAccentBrush}" />
  </Style>
  <Style Selector="Button.wgt-atlas-node.core">
    <Setter Property="BorderBrush" Value="{DynamicResource WgtAccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="26" />
  </Style>
  <Style Selector="Button.wgt-atlas-node.service">
    <Setter Property="CornerRadius" Value="20" />
  </Style>
  <Style Selector="Button.wgt-atlas-node.capability">
    <Setter Property="CornerRadius" Value="14" />
  </Style>
  <Style Selector="Button.wgt-atlas-node.selected">
    <Setter Property="Background" Value="{DynamicResource WgtAtlasSelectedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WgtAccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button.wgt-atlas-node.unavailable">
    <Setter Property="Opacity" Value="0.66" />
  </Style>

  <Style Selector="TextBlock.wgt-node-kind">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource WgtSecondaryForegroundBrush}" />
  </Style>
  <Style Selector="Border.wgt-atlas-status-dot">
    <Setter Property="Background" Value="{DynamicResource WgtAccentBrush}" />
  </Style>
  <Style Selector="Border.wgt-atlas-status-dot.unavailable">
    <Setter Property="Background" Value="{DynamicResource WgtSecondaryForegroundBrush}" />
    <Setter Property="Opacity" Value="0.55" />
  </Style>

  <Style Selector="Button.wgt-atlas-node.theme-technical">
    <Setter Property="CornerRadius" Value="11" />
  </Style>
  <Style Selector="Button.wgt-atlas-node.core.theme-technical">
    <Setter Property="CornerRadius" Value="15" />
  </Style>
  <Style Selector="Button.wgt-atlas-node.theme-elegant">
    <Setter Property="CornerRadius" Value="30" />
    <Setter Property="Opacity" Value="0.98" />
  </Style>
  <Style Selector="Button.wgt-atlas-node.core.theme-elegant">
    <Setter Property="CornerRadius" Value="40" />
  </Style>
  <Style Selector="Button.wgt-atlas-node.theme-machine">
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button.wgt-atlas-node.capability.theme-machine">
    <Setter Property="CornerRadius" Value="2" />
  </Style>
  <Style Selector="Button.wgt-atlas-node.theme-world">
    <Setter Property="CornerRadius" Value="30" />
    <Setter Property="BorderBrush" Value="{DynamicResource WgtAccentBrush}" />
  </Style>
  <Style Selector="Button.wgt-atlas-node.core.theme-world">
    <Setter Property="CornerRadius" Value="46" />
  </Style>
  <Style Selector="Button.wgt-atlas-node.capability.theme-world">
    <Setter Property="CornerRadius" Value="32" />
  </Style>

  <Style Selector="Line.wgt-atlas-connection">
    <Setter Property="Stroke" Value="{DynamicResource WgtAtlasConnectionBrush}" />
    <Setter Property="StrokeThickness" Value="1.7" />
  </Style>
  <Style Selector="Line.wgt-atlas-connection.capability">
    <Setter Property="Stroke" Value="{DynamicResource WgtAtlasCapabilityConnectionBrush}" />
    <Setter Property="StrokeThickness" Value="1.35" />
  </Style>
  <Style Selector="Line.wgt-atlas-connection.dependency">
    <Setter Property="Stroke" Value="{DynamicResource WgtAtlasDependencyConnectionBrush}" />
    <Setter Property="StrokeThickness" Value="2.4" />
    <Setter Property="StrokeDashArray" Value="7,4" />
  </Style>
  <Style Selector="Line.wgt-atlas-connection.theme-elegant">
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="Opacity" Value="0.58" />
  </Style>
  <Style Selector="Line.wgt-atlas-connection.dependency.theme-elegant">
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="StrokeDashArray" Value="4,5" />
  </Style>
  <Style Selector="Line.wgt-atlas-connection.theme-machine">
    <Setter Property="StrokeThickness" Value="2.6" />
  </Style>
  <Style Selector="Line.wgt-atlas-connection.capability.theme-machine">
    <Setter Property="StrokeThickness" Value="2" />
  </Style>
  <Style Selector="Line.wgt-atlas-connection.dependency.theme-machine">
    <Setter Property="StrokeThickness" Value="3" />
    <Setter Property="StrokeDashArray" Value="10,3" />
  </Style>
  <Style Selector="Line.wgt-atlas-connection.theme-world">
    <Setter Property="Stroke" Value="{DynamicResource WgtAccentBrush}" />
    <Setter Property="StrokeThickness" Value="2.25" />
    <Setter Property="Opacity" Value="0.46" />
  </Style>
  <Style Selector="Line.wgt-atlas-connection.dependency.theme-world">
    <Setter Property="StrokeThickness" Value="3" />
    <Setter Property="StrokeDashArray" Value="2,5" />
    <Setter Property="Opacity" Value="0.72" />
  </Style>

  <Style Selector="Border.wgt-atlas-search-dock">
    <Setter Property="Background" Value="{DynamicResource WgtAtlasChromeBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WgtDividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="BoxShadow" Value="0 12 34 0 #4A000000" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.wgt-atlas-orb">
    <Setter Property="Background" Value="{DynamicResource WgtAtlasChromeBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WgtDividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.wgt-atlas-inspector">
    <Setter Property="Background" Value="{DynamicResource WgtAtlasChromeBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WgtDividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="BoxShadow" Value="0 18 46 0 #56000000" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Border.wgt-atlas-inspector.theme-elegant">
    <Setter Property="CornerRadius" Value="26" />
  </Style>
  <Style Selector="Border.wgt-atlas-inspector.theme-machine">
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Border.wgt-atlas-inspector.theme-world">
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="BorderBrush" Value="{DynamicResource WgtAccentBrush}" />
  </Style>
  <Style Selector="Border.wgt-atlas-kind-chip">
    <Setter Property="Background" Value="{DynamicResource WgtAccentLowBrush}" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.wgt-inspector-close">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="18" />
  </Style>
  <Style Selector="Button.wgt-inspector-close:pointerover">
    <Setter Property="Background" Value="{DynamicResource WgtAccentLowBrush}" />
  </Style>
  <Style Selector="TabControl.wgt-atlas-tabs">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.wgt-atlas-popover">
    <Setter Property="Background" Value="{DynamicResource WgtAtlasChromeBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WgtDividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="BoxShadow" Value="0 8 24 0 #33000000" />
  </Style>
  <Style Selector="Border.wgt-atlas-controls">
    <Setter Property="Background" Value="{DynamicResource WgtAtlasChromeBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WgtDividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Opacity" Value="0.88" />
  </Style>
  <Style Selector="Border.wgt-atlas-controls.theme-machine">
    <Setter Property="CornerRadius" Value="2" />
  </Style>
  <Style Selector="Border.wgt-atlas-controls.theme-elegant">
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Opacity" Value="0.78" />
  </Style>

  <Style Selector="Button.wgt-theme-choice">
    <Setter Property="Background" Value="{DynamicResource WgtAtlasChromeBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WgtDividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.wgt-theme-choice.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource WgtAccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.wgt-primary-action">
    <Setter Property="Background" Value="{DynamicResource WgtAccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Button.wgt-product-return">
    <Setter Property="Background" Value="{DynamicResource WgtAtlasChromeBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WgtAccentBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="FontSize" Value="18" />
  </Style>
</Styles>
