<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <!-- WGT spacing and type tokens; colors resolve from Fluent's active light/dark palette. -->
    <Thickness x:Key="WgtSpaceXs">4</Thickness>
    <Thickness x:Key="WgtSpaceSm">8</Thickness>
    <Thickness x:Key="WgtSpaceMd">12</Thickness>
    <Thickness x:Key="WgtSpaceLg">20</Thickness>
    <x:Double x:Key="WgtTypeBody">15</x:Double>
    <x:Double x:Key="WgtTypeSection">20</x:Double>
    <x:Double x:Key="WgtTypePageTitle">28</x:Double>

    <SolidColorBrush x:Key="WgtSurfaceBrush" Color="{DynamicResource SystemRegionColor}" />
    <SolidColorBrush x:Key="WgtDividerBrush" Color="{DynamicResource SystemBaseLowColor}" />
    <SolidColorBrush x:Key="WgtForegroundBrush" Color="{DynamicResource SystemBaseHighColor}" />
    <SolidColorBrush x:Key="WgtSecondaryForegroundBrush" Color="{DynamicResource SystemBaseMediumColor}" />
    <SolidColorBrush x:Key="WgtAccentBrush" Color="{DynamicResource SystemAccentColor}" />
    <SolidColorBrush x:Key="WgtAccentLowBrush" Color="{DynamicResource SystemAccentColor}" Opacity="0.12" />
    <SolidColorBrush x:Key="WgtMapBackgroundBrush" Color="{DynamicResource SystemRegionColor}" />
    <SolidColorBrush x:Key="WgtMapGridBrush" Color="{DynamicResource SystemBaseLowColor}" />
    <SolidColorBrush x:Key="WgtMapPointBrush" Color="{DynamicResource SystemAccentColor}" />
  </Styles.Resources>

  <Style Selector="TextBlock.wgt-page-title">
    <Setter Property="FontSize" Value="{DynamicResource WgtTypePageTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource WgtForegroundBrush}" />
  </Style>
  <Style Selector="TextBlock.wgt-section-title">
    <Setter Property="FontSize" Value="{DynamicResource WgtTypeSection}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource WgtForegroundBrush}" />
  </Style>
  <Style Selector="TextBlock.wgt-body">
    <Setter Property="FontSize" Value="{DynamicResource WgtTypeBody}" />
    <Setter Property="Foreground" Value="{DynamicResource WgtForegroundBrush}" />
  </Style>
  <Style Selector="TextBlock.wgt-secondary">
    <Setter Property="Foreground" Value="{DynamicResource WgtSecondaryForegroundBrush}" />
  </Style>
  <Style Selector="TextBlock.wgt-caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource WgtSecondaryForegroundBrush}" />
  </Style>

  <Style Selector="Button.wgt-nav-button">
    <Setter Property="MinWidth" Value="100" />
    <Setter Property="Padding" Value="{DynamicResource WgtSpaceMd},8" />
  </Style>
  <Style Selector="Button.wgt-action-button">
    <Setter Property="Padding" Value="{DynamicResource WgtSpaceMd},8" />
  </Style>
  <Style Selector="RadioButton.wgt-shell-nav">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="{DynamicResource WgtSpaceMd},10" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="RadioButton.wgt-shell-nav:checked">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource WgtAccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource WgtAccentLowBrush}" />
  </Style>
  <Style Selector="RadioButton.wgt-mobile-nav">
    <Setter Property="Padding" Value="{DynamicResource WgtSpaceMd},8" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="MinWidth" Value="84" />
  </Style>
  <Style Selector="RadioButton.wgt-mobile-nav:checked">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Border.wgt-shell-sidebar">
    <Setter Property="Background" Value="{DynamicResource WgtSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WgtDividerBrush}" />
  </Style>
  <Style Selector="Border.wgt-surface">
    <Setter Property="Background" Value="{DynamicResource WgtSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WgtDividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="{DynamicResource WgtSpaceMd}" />
  </Style>
  <Style Selector="Border.wgt-product-card">
    <Setter Property="Background" Value="{DynamicResource WgtSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WgtDividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="{DynamicResource WgtSpaceLg}" />
    <Setter Property="MinHeight" Value="168" />
  </Style>
  <Style Selector="Border.wgt-list-divider">
    <Setter Property="BorderBrush" Value="{DynamicResource WgtDividerBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.wgt-opportunity-card">
    <Setter Property="Background" Value="{DynamicResource WgtSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WgtDividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="{DynamicResource WgtSpaceLg}" />
  </Style>
  <Style Selector="Border.wgt-state-banner">
    <Setter Property="Background" Value="{DynamicResource WgtSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WgtDividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="{DynamicResource WgtSpaceMd}" />
  </Style>
  <Style Selector="Border.wgt-map-surface">
    <Setter Property="Background" Value="{DynamicResource WgtMapBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WgtDividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
</Styles>
