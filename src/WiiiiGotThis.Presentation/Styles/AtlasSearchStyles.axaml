<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.wgt-atlas-search-results">
    <Setter Property="Background" Value="{DynamicResource WgtAtlasOpaqueRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WgtAtlasNodeBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="BoxShadow" Value="0 18 44 0 #66000000" />
  </Style>

  <Style Selector="Button.wgt-atlas-search-result">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="Button.wgt-atlas-search-result:pointerover">
    <Setter Property="Background" Value="{DynamicResource WgtAccentLowBrush}" />
  </Style>
  <Style Selector="Button.wgt-atlas-search-result:focus-visible">
    <Setter Property="Background" Value="{DynamicResource WgtAccentLowBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WgtAccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
</Styles>
