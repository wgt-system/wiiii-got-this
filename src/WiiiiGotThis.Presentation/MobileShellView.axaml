<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:WiiiiGotThis.Presentation" xmlns:p="using:WiiiiGotThis.Presentation" x:Class="WiiiiGotThis.Presentation.MobileShellView" x:DataType="vm:ShellViewModel">
  <TabControl Margin="12">
    <TabItem Header="Home">
      <StackPanel Spacing="12"><TextBlock Classes="wgt-page-title">Wiiii Got This</TextBlock><TextBlock Classes="wgt-secondary" Text="{Binding CurrentDeviceName}" /><TextBlock Classes="wgt-body" Text="Your connected WGT product areas will appear here." TextWrapping="Wrap" /><TextBlock Classes="wgt-secondary" Text="Use Settings to manage integrations and published capabilities." TextWrapping="Wrap" /></StackPanel>
    </TabItem>
    <TabItem Header="Settings">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="12"><TextBlock FontSize="24" FontWeight="Bold">Settings</TextBlock><Button Command="{Binding RefreshCommand}" Content="Refresh" HorizontalAlignment="Left" /><TextBlock FontWeight="Bold">Integrations</TextBlock><ListBox ItemsSource="{Binding Integrations}" SelectedItem="{Binding SelectedIntegration, Mode=TwoWay}"><ListBox.ItemTemplate><DataTemplate x:DataType="p:ServiceIntegrationPresentationViewModel"><StackPanel Margin="0,5"><TextBlock Text="{Binding DisplayName}" /><TextBlock Text="{Binding EnablementStatusText}" /><TextBlock Text="{Binding PublicationRefreshStatusText}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Spacing="4"><TextBlock Text="{Binding SelectedIntegration.DisplayName}" FontWeight="Bold" /><TextBlock Text="{Binding SelectedIntegration.PublicationRefreshStatusText}" TextWrapping="Wrap" /><TextBlock Text="{Binding SelectedIntegration.LastRefreshAttemptText}" FontSize="11" /><TextBlock Text="{Binding SelectedIntegration.LastSuccessfulRefreshText}" FontSize="11" /></StackPanel><WrapPanel><Button Command="{Binding EnableGloballyCommand}" Content="Enable globally" Margin="0,0,5,5" /><Button Command="{Binding DisableGloballyCommand}" Content="Disable globally" Margin="0,0,5,5" /><Button Command="{Binding EnableOnThisDeviceCommand}" Content="Enable on this device" Margin="0,0,5,5" /><Button Command="{Binding DisableOnThisDeviceCommand}" Content="Disable on this device" Margin="0,0,5,5" /><Button Command="{Binding InheritGlobalSettingCommand}" Content="Inherit global setting" /></WrapPanel><Separator /><TextBlock FontWeight="Bold">Published capabilities</TextBlock><ListBox ItemsSource="{Binding Capabilities}" SelectedItem="{Binding SelectedCapability, Mode=TwoWay}"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:CapabilityPresentationViewModel"><StackPanel Margin="0,5"><TextBlock Text="{Binding CapabilityTitle}" /><TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel IsVisible="{Binding IsCapabilityDetailsVisible}" Spacing="8"><TextBlock Text="{Binding SelectedCapability.CapabilityTitle}" FontSize="22" /><TextBlock Text="{Binding SelectedCapability.ServiceDisplayName}" /><TextBlock Text="{Binding SelectedCapability.CapabilityIdentity.Value}" /><TextBlock Text="{Binding SelectedCapability.ContractVersion}" /><TextBlock Text="{Binding SelectedCapability.StatusText}" TextWrapping="Wrap" /><Button Command="{Binding OpenCapabilityCommand}" Content="Open" HorizontalAlignment="Left" /></StackPanel><StackPanel IsVisible="{Binding IsReferenceCapabilityOpen}" Spacing="8"><TextBlock Text="{Binding OpenedReferenceCapability.CapabilityTitle}" FontSize="22" /><TextBlock Text="{Binding OpenedReferenceCapability.ServiceDisplayName}" /><TextBlock Text="Available" /><TextBlock Text="This reference capability is available through Wiiii Got This." TextWrapping="Wrap" /><Button Command="{Binding BackToCatalogCommand}" Content="Back to catalog" HorizontalAlignment="Left" /></StackPanel></StackPanel></ScrollViewer>
    </TabItem>
  </TabControl>
</UserControl>
