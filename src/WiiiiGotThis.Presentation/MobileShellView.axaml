<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:WiiiiGotThis.Presentation" xmlns:app="using:WiiiiGotThis.Application" xmlns:p="using:WiiiiGotThis.Presentation" x:Class="WiiiiGotThis.Presentation.MobileShellView" x:DataType="vm:ShellViewModel">
  <TabControl Margin="12">
    <TabItem Header="Integrations"><StackPanel Spacing="8"><TextBlock FontSize="24" FontWeight="Bold">Wiiii Got This</TextBlock><TextBlock Text="{Binding CurrentDeviceName}" /><Button Command="{Binding RefreshCommand}" Content="Refresh" HorizontalAlignment="Left" /><ListBox ItemsSource="{Binding Integrations}" SelectedItem="{Binding SelectedIntegration, Mode=TwoWay}"><ListBox.ItemTemplate><DataTemplate x:DataType="p:ServiceIntegrationPresentationViewModel"><StackPanel Margin="0,5"><TextBlock Text="{Binding DisplayName}" /><TextBlock Text="{Binding EnablementStatusText}" /><TextBlock Text="{Binding PublicationRefreshStatusText}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Spacing="4"><TextBlock Text="{Binding SelectedIntegration.DisplayName}" FontWeight="Bold" /><TextBlock Text="{Binding SelectedIntegration.PublicationRefreshStatusText}" TextWrapping="Wrap" /><TextBlock Text="{Binding SelectedIntegration.LastRefreshAttemptText}" FontSize="11" /><TextBlock Text="{Binding SelectedIntegration.LastSuccessfulRefreshText}" FontSize="11" /></StackPanel><WrapPanel><Button Command="{Binding EnableGloballyCommand}" Content="Enable globally" Margin="0,0,5,5" /><Button Command="{Binding DisableGloballyCommand}" Content="Disable globally" Margin="0,0,5,5" /><Button Command="{Binding EnableOnThisDeviceCommand}" Content="Enable on this device" Margin="0,0,5,5" /><Button Command="{Binding DisableOnThisDeviceCommand}" Content="Disable on this device" Margin="0,0,5,5" /><Button Command="{Binding InheritGlobalSettingCommand}" Content="Inherit global setting" /></WrapPanel></StackPanel></TabItem>
    <TabItem Header="Capabilities"><ListBox ItemsSource="{Binding Capabilities}" SelectedItem="{Binding SelectedCapability, Mode=TwoWay}"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:CapabilityPresentationViewModel"><StackPanel Margin="0,5"><TextBlock Text="{Binding CapabilityTitle}" /><TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></TabItem>
    <TabItem Header="Details"><StackPanel Spacing="8"><StackPanel IsVisible="{Binding IsCapabilityDetailsVisible}" Spacing="8"><TextBlock Text="{Binding SelectedCapability.CapabilityTitle}" FontSize="22" /><TextBlock Text="{Binding SelectedCapability.ServiceDisplayName}" /><TextBlock Text="{Binding SelectedCapability.CapabilityIdentity.Value}" /><TextBlock Text="{Binding SelectedCapability.ContractVersion}" /><TextBlock Text="{Binding SelectedCapability.StatusText}" TextWrapping="Wrap" /><Button Command="{Binding OpenCapabilityCommand}" Content="Open" HorizontalAlignment="Left" /></StackPanel><StackPanel IsVisible="{Binding IsReferenceCapabilityOpen}" Spacing="8"><TextBlock Text="{Binding OpenedReferenceCapability.CapabilityTitle}" FontSize="22" /><TextBlock Text="{Binding OpenedReferenceCapability.ServiceDisplayName}" /><TextBlock Text="{Binding OpenedReferenceCapability.CapabilityIdentity.Value}" /><TextBlock Text="{Binding OpenedReferenceCapability.ContractVersion}" /><TextBlock Text="Available" /><TextBlock Text="This reference capability is available through Wiiii Got This." TextWrapping="Wrap" /><Button Command="{Binding BackToCatalogCommand}" Content="Back to catalog" HorizontalAlignment="Left" /></StackPanel></StackPanel></TabItem>
  </TabControl>
</UserControl>
