<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:WiiiiGotThis.Presentation" xmlns:app="using:WiiiiGotThis.Application" x:Class="WiiiiGotThis.Presentation.MobileShellView" x:DataType="vm:ShellViewModel">
  <TabControl Margin="12">
    <TabItem Header="Integrations"><StackPanel Spacing="8"><TextBlock FontSize="24" FontWeight="Bold">Wiiii Got This</TextBlock><TextBlock Text="{Binding CurrentDeviceName}" /><Button Command="{Binding RefreshCommand}" Content="Refresh" HorizontalAlignment="Left" /><ListBox ItemsSource="{Binding Integrations}" SelectedItem="{Binding SelectedIntegration, Mode=TwoWay}"><ListBox.ItemTemplate><DataTemplate x:DataType="app:ServiceIntegrationListItem"><StackPanel Margin="0,5"><TextBlock Text="{Binding DisplayName}" /><TextBlock Text="{Binding IsEffectivelyEnabled}" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><WrapPanel><Button Command="{Binding EnableGloballyCommand}" Content="Enable globally" Margin="0,0,5,5" /><Button Command="{Binding DisableGloballyCommand}" Content="Disable globally" Margin="0,0,5,5" /><Button Command="{Binding InheritGlobalSettingCommand}" Content="Inherit" /></WrapPanel></StackPanel></TabItem>
    <TabItem Header="Capabilities"><ListBox ItemsSource="{Binding Capabilities}" SelectedItem="{Binding SelectedCapability, Mode=TwoWay}"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:CapabilityPresentationViewModel"><StackPanel Margin="0,5"><TextBlock Text="{Binding CapabilityTitle}" /><TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></TabItem>
    <TabItem Header="Details"><StackPanel Spacing="8"><TextBlock Text="{Binding SelectedCapability.CapabilityTitle}" FontSize="22" /><TextBlock Text="{Binding SelectedCapability.ServiceDisplayName}" /><TextBlock Text="{Binding SelectedCapability.CapabilityIdentity.Value}" /><TextBlock Text="{Binding SelectedCapability.ContractVersion}" /><TextBlock Text="{Binding SelectedCapability.StatusText}" TextWrapping="Wrap" /><Button Command="{Binding OpenCapabilityCommand}" Content="Open" HorizontalAlignment="Left" /><TextBlock Text="{Binding OpenedReferenceCapability.CapabilityTitle}" /><TextBlock Text="This reference capability is available through Wiiii Got This." TextWrapping="Wrap" /><Button Command="{Binding BackToCatalogCommand}" Content="Back to catalog" HorizontalAlignment="Left" /></StackPanel></TabItem>
  </TabControl>
</UserControl>
