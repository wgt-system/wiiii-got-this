<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="using:WiiiiGotThis.Presentation" x:Class="WiiiiGotThis.Presentation.VocationOpportunityOverviewView" x:DataType="v:VocationOpportunityOverviewViewModel">
  <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <Grid IsVisible="{Binding IsLoaded}" ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <StackPanel Spacing="3">
          <Label Target="JobsSearchBox" Content="_Find jobs" />
          <TextBox x:Name="JobsSearchBox" AutomationProperties.Name="Search jobs" AutomationProperties.AutomationId="JobsSearch" Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="Title, company, or location" MinWidth="240" />
          <TextBlock Classes="wgt-caption" Text="{Binding ResultCountText}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="3">
          <Label Target="JobsSortBox" Content="S_ort" />
          <ComboBox x:Name="JobsSortBox" AutomationProperties.Name="Sort jobs" AutomationProperties.AutomationId="JobsSort" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}" MinWidth="170" />
        </StackPanel>
      </Grid>
      <Button Grid.Column="1" Classes="wgt-action-button" AutomationProperties.Name="Refresh jobs" AutomationProperties.AutomationId="JobsRefresh" Command="{Binding RefreshCommand}" Content="_Refresh" VerticalAlignment="Bottom" />
    </Grid>

    <Border Grid.Row="1" Classes="wgt-state-banner" IsVisible="{Binding IsStateBannerVisible}" AutomationProperties.Name="Jobs status">
      <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
        <TextBlock Classes="wgt-section-title" Text="{Binding StateTitle}" />
        <TextBlock Grid.Row="1" Classes="wgt-secondary" Text="{Binding StateDescription}" TextWrapping="Wrap" />
        <ProgressBar Grid.Row="2" Classes="wgt-state-progress" IsVisible="{Binding IsLoading}" IsIndeterminate="True" Height="4" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Classes="wgt-state-banner" IsVisible="{Binding HasNoMatches}" AutomationProperties.Name="No matching jobs">
      <StackPanel Spacing="4">
        <TextBlock Classes="wgt-section-title">No matching opportunities</TextBlock>
        <TextBlock Classes="wgt-secondary" Text="Try a different title, company, or location." />
      </StackPanel>
    </Border>

    <ListBox Grid.Row="2" IsVisible="{Binding HasVisibleOpportunities}" ItemsSource="{Binding VisibleOpportunities}" AutomationProperties.Name="Published jobs" AutomationProperties.AutomationId="JobsResults">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="v:VocationOpportunityItemViewModel">
          <Border Classes="wgt-opportunity-row" HorizontalAlignment="Stretch">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="5" ColumnSpacing="16">
              <StackPanel Spacing="3">
                <TextBlock Classes="wgt-section-title" FontSize="17" Text="{Binding Title}" TextWrapping="Wrap" />
                <TextBlock Classes="wgt-body" Text="{Binding CompanyName}" TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock Grid.Column="1" Classes="wgt-caption" Text="{Binding PostingCountText}" VerticalAlignment="Top" />
              <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="wgt-secondary" Text="{Binding WorkLocationsText}" TextWrapping="Wrap" />
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock Grid.Row="3" Classes="wgt-caption" IsVisible="{Binding HasPublicationMetadata}" Text="{Binding PublicationMetadataText}" TextTrimming="CharacterEllipsis" />
  </Grid>
</UserControl>
