<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="using:WiiiiGotThis.Presentation" x:Class="WiiiiGotThis.Presentation.VocationOpportunityOverviewView" x:DataType="v:VocationOpportunityOverviewViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16" Margin="4">
      <Grid ColumnDefinitions="*,Auto">
        <Button Classes="wgt-action-button" Grid.Column="1" Command="{Binding RefreshCommand}" Content="Refresh" VerticalAlignment="Top" />
      </Grid>

      <Border Classes="wgt-state-banner">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
          <TextBlock Classes="wgt-section-title" Text="{Binding StateTitle}" />
          <TextBlock Grid.Row="1" Classes="wgt-secondary" Text="{Binding StateDescription}" TextWrapping="Wrap" />
          <ProgressBar Grid.Row="2" Classes="wgt-state-progress" IsVisible="{Binding IsLoading}" IsIndeterminate="True" Height="4" />
        </Grid>
      </Border>

      <ItemsControl IsVisible="{Binding IsLoaded}" ItemsSource="{Binding Opportunities}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="v:VocationOpportunityItemViewModel">
            <Border Classes="wgt-opportunity-card" Margin="0,0,0,12">
              <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6">
                <TextBlock Classes="wgt-section-title" Text="{Binding Title}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Classes="wgt-caption" Text="{Binding PostingCountText}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Classes="wgt-body" Text="{Binding CompanyName}" />
                <TextBlock Grid.Row="2" Classes="wgt-secondary" Text="{Binding WorkLocationsText}" TextWrapping="Wrap" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Classes="wgt-surface" IsVisible="{Binding HasPublicationMetadata}">
        <TextBlock Classes="wgt-caption" Text="{Binding PublicationMetadataText}" />
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
