<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="using:WiiiiGotThis.Presentation" x:Class="WiiiiGotThis.Presentation.VocationOpportunityOverviewView" x:DataType="v:VocationOpportunityOverviewViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16" Margin="4">
      <StackPanel Spacing="4">
        <TextBlock Classes="wgt-section-title" Text="Opportunity Overview" />
        <TextBlock Classes="wgt-secondary" Text="Vocation · Jobs" />
        <TextBlock Text="{Binding StateText}" TextWrapping="Wrap" />
        <TextBlock Classes="wgt-caption" Text="{Binding GeneratedAtText}" />
      </StackPanel>
      <Button Command="{Binding RefreshCommand}" Content="Refresh opportunities" HorizontalAlignment="Left" />
      <ItemsControl ItemsSource="{Binding Opportunities}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="v:VocationOpportunityItemViewModel">
            <Border Classes="wgt-list-divider" Padding="0,8,0,12">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding CompanyName}" FontWeight="Medium" />
                <TextBlock Classes="wgt-secondary" Text="{Binding WorkLocationsText}" TextWrapping="Wrap" />
                <TextBlock Classes="wgt-secondary" Text="{Binding PostingCountText}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
