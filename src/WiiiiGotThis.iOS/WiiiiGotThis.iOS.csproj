<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>WiiiiGotThis.iOS</RootNamespace>
    <AssemblyName>WiiiiGotThis.iOS</AssemblyName>
    <!-- Windows CI can build the iOS project structurally; pass -p:BuildiOS=true on a Mac/iOS workload host. -->
    <TargetFramework Condition="'$(BuildiOS)' == 'true'">net10.0-ios</TargetFramework>
    <TargetFramework Condition="'$(BuildiOS)' != 'true'">net10.0</TargetFramework>
    <DefineConstants Condition="'$(BuildiOS)' == 'true'">$(DefineConstants);WGT_IOS</DefineConstants>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Avalonia 12.0.4 currently emits an external DesignerSupport trim summary. Keep compiler warnings-as-errors, but let CI inspect linker warnings explicitly. -->
    <ILLinkTreatWarningsAsErrors Condition="'$(BuildiOS)' == 'true'">false</ILLinkTreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WiiiiGotThis.Application\WiiiiGotThis.Application.csproj" />
    <ProjectReference Include="..\WiiiiGotThis.Infrastructure\WiiiiGotThis.Infrastructure.csproj" />
    <ProjectReference Include="..\WiiiiGotThis.Integrations.Reference\WiiiiGotThis.Integrations.Reference.csproj" />
    <ProjectReference Include="..\WiiiiGotThis.Presentation\WiiiiGotThis.Presentation.csproj" />
    <PackageReference Include="Avalonia.iOS" Condition="'$(BuildiOS)' == 'true'" />
  </ItemGroup>
  <ItemGroup Condition="'$(BuildiOS)' == 'true'">
    <BundleResource Include="..\WiiiiGotThis.Desktop\orientation-map\embed.html" LogicalName="orientation-map/embed.html" />
    <BundleResource Include="..\WiiiiGotThis.Desktop\orientation-map\ORIENTATION_SOURCE_SHA.txt" LogicalName="orientation-map/ORIENTATION_SOURCE_SHA.txt" />
    <BundleResource Include="..\WiiiiGotThis.Desktop\orientation-map\assets\embed-BqSQ54JR.js" LogicalName="orientation-map/assets/embed-BqSQ54JR.js" />
    <BundleResource Include="..\WiiiiGotThis.Desktop\orientation-map\assets\feature-details-BesweY1v.css" LogicalName="orientation-map/assets/feature-details-BesweY1v.css" />
    <BundleResource Include="..\WiiiiGotThis.Desktop\orientation-map\assets\feature-details-BUjUJ-S9.js" LogicalName="orientation-map/assets/feature-details-BUjUJ-S9.js" />
    <BundleResource Include="..\WiiiiGotThis.Desktop\orientation-map\assets\maplibre-gl-worker-DagF8W22.js" LogicalName="orientation-map/assets/maplibre-gl-worker-DagF8W22.js" />
    <BundleResource Include="..\WiiiiGotThis.Desktop\orientation-map\assets\reference-DFaAhDcG.js" LogicalName="orientation-map/assets/reference-DFaAhDcG.js" />
  </ItemGroup>
</Project>
